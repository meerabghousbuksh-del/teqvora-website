{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teqvora",
  "main": "src/index.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  }
}